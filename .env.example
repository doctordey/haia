# Haia — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Database (Railway PostgreSQL plugin auto-provisions this) ───
DATABASE_URL="postgresql://user:password@host:5432/haia"

# ─── Redis (Railway Redis plugin, used by background sync worker) ───
REDIS_URL="redis://default:password@host:6379"

# ─── Auth (NextAuth v5) ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-char-string-here"
NEXTAUTH_SECRET="generate-a-random-32-char-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── MetaApi ───
# Get your token at https://app.metaapi.cloud
METAAPI_TOKEN=""

# ─── Google OAuth (optional — leave blank to disable) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Telegram (from https://my.telegram.org) ───
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── TradingView Webhook (offset data — must match your Pine Script indicator) ───
# Generate with: openssl rand -hex 16
TRADINGVIEW_WEBHOOK_SECRET=

# ─── HITL (Human-in-the-Loop execution) ───
# Master switch — HITL only boots when this is exactly "true". Leave unset to disable.
HITL_ENABLED=
# Safety: stays demo-only until §7 acceptance passes. Keep false; flip to "true"
# only after acceptance to allow dispatch on a live (non-demo) account.
HITL_ALLOW_LIVE=false
# Telegram BOT (BotFather) — separate from the GramJS channel listener above.
HITL_TELEGRAM_BOT_TOKEN=
# Authorized users + operator/group chat are managed in-app:
#   Settings → HITL → Access  (live, no redeploy).
# These two are optional SEEDS, merged with the in-app values (DB wins for chat).
# Comma-separated numeric Telegram user ids allowed to reply/approve.
AUTHORIZED_TELEGRAM_USER_IDS=
# Chat id where prompts/confirm cards are sent (your id for DM, group id for a group).
HITL_OPERATOR_CHAT_ID=
# Shared secret for the webhooks (openssl rand -hex 16). TradingView alert text
# isn't JSON, so pass it in the URL: https://<domain>/haia/hitl/tv-alert?secret=<this>
HITL_WEBHOOK_SECRET=
# Optional SEED for the symbol map (TradingView ticker → broker symbol).
# Prefer managing these in the app: Settings → HITL → Symbol Map. DB entries
# override anything set here. Comma-separated tv:broker pairs, e.g. "UK10YBGBP:UKGILT".
HITL_SYMBOL_MAP=
# Timing / intake guards (seconds).
SIGNAL_TIMEOUT_SECONDS=300
SIGNAL_COOLDOWN_SECONDS=60
# Risk: default % risk per trade and the hard cap (pre-dispatch gate).
RISK_PCT=1.0
MAX_RISK_PER_TRADE=5.0
# Behaviour switches (locked defaults — see HITL_DESIGN.md).
SL_FROM=range_size              # range_size | protective_edge
POSITION_MODEL=two_position     # two_position | single
ENTRY_MODE=market               # market | pending
BE_TRIGGER=both                 # both | internal | webhook
TP2_CLOSE_PCT=50                # single-mode scale-out (inert in two_position)
LEG_SPLIT=0.5                   # two-position Leg A share of total lots
MAX_DEVIATION_POINTS=10         # market slippage cap
SCANNER_FILL=close_through      # inert unless POSITION_MODEL=single
PARTIAL_LEG_FAILURE=alert_hold  # alert_hold | auto_close
# NOTE: the target account is NOT set here — enable "HITL" per-account in Settings.

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Haia"
