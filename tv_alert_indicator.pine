// ============================================================================
// Haia TradingView Alert → FusionMarkets Webhook (Unicorn° Pro+ compatible)
// ============================================================================
//
// The Unicorn° Pro+ indicator already fires the alert events we need:
//   - Activation
//   - Target Reached
//   - Invalidation Hit
//   - (Invalidation Warning + Potential Breaker — logged only)
//
// SETUP (no Pine editing needed):
//
// 1. In the indicator settings, enable the alert types you want:
//      Activation?, Target Reached?, Invalidation Hit?
//
// 2. In TradingView, create ONE alert per type, per chart:
//
//      Activation:
//        Condition: Unicorn° [Pro+]  →  Activation?
//        Webhook URL: https://YOUR_HAIA_URL/api/signals/tradingview/webhook
//        Message: <paste the ACTIVATION_TEMPLATE below>
//
//      Target Reached:
//        Condition: Unicorn° [Pro+]  →  Target Reached?
//        Webhook URL: (same)
//        Message: <paste the TARGET_REACHED_TEMPLATE below>
//
//      Invalidation Hit:
//        Condition: Unicorn° [Pro+]  →  Invalidation Hit?
//        Webhook URL: (same)
//        Message: <paste the INVALIDATION_HIT_TEMPLATE below>
//
// 3. Replace YOUR_SECRET in each template with TRADINGVIEW_WEBHOOK_SECRET
//    (the same value set in your Haia env vars on Railway).
//
// CROSS-FEED SYMBOLS:
//    If the chart's symbol differs from the FusionMarkets ticker (e.g.
//    UK10YBG on TV vs UKGILT on Fusion), the offset is computed server-side
//    when you also include fusion_price. The indicator can't fetch a Fusion
//    price natively, so either:
//      (a) Use a TradingView Spread chart (TV:UK10YBG-FUSION:UKGILT) and
//          pass {{plot("Spread")}} as the offset, or
//      (b) Run a parallel companion indicator that publishes
//          fusion_price via webhook (see existing offset webhook pattern),
//          and omit fusion_price from these payloads.
//    For symbols whose TV ticker matches the Fusion ticker (most cases),
//    omit fusion_price entirely.
// ============================================================================

// ── ACTIVATION_TEMPLATE ─────────────────────────────────────────────────────
// Required: tv_symbol, direction, tv_price, breaker_high, breaker_low
// Optional: fusion_price (only when TV ticker != Fusion ticker)
//
// {
//   "secret": "YOUR_SECRET",
//   "alert_type": "activation",
//   "tv_symbol": "{{ticker}}",
//   "direction": "LONG",
//   "tv_price": {{close}},
//   "breaker_high": {{plot("Breaker High")}},
//   "breaker_low":  {{plot("Breaker Low")}},
//   "prev_5m_high": {{high}},
//   "prev_5m_low":  {{low}},
//   "timestamp":    "{{timenow}}"
// }
//
// Notes:
// - Create a SEPARATE TradingView alert for LONG vs SHORT activations if
//   Unicorn distinguishes them as different conditions. Hardcode "direction"
//   in each template accordingly.
// - If Unicorn doesn't expose Breaker High/Low as named plots, leave those
//   lines out — the server will fall back to prev_5m_high/low.

// ── TARGET_REACHED_TEMPLATE ─────────────────────────────────────────────────
// Required: tv_symbol, r_level
//
// {
//   "secret":     "YOUR_SECRET",
//   "alert_type": "target_reached",
//   "tv_symbol":  "{{ticker}}",
//   "tv_price":   {{close}},
//   "r_level":    1,
//   "timestamp":  "{{timenow}}"
// }
//
// Notes:
// - If Unicorn fires Target Reached separately for 1R, 2R, and 5R, create
//   THREE TradingView alerts (one per R level), each pinned to the matching
//   condition, and hardcode r_level: 1 / 2 / 5 in the template.
// - If it exposes the R level as a plot, use:
//       "r_level": {{plot("R Level")}}
//   in a single alert and the server will dispatch based on the value.

// ── INVALIDATION_HIT_TEMPLATE ───────────────────────────────────────────────
// Required: tv_symbol
//
// {
//   "secret":     "YOUR_SECRET",
//   "alert_type": "invalidation_hit",
//   "tv_symbol":  "{{ticker}}",
//   "tv_price":   {{close}},
//   "timestamp":  "{{timenow}}"
// }
//
// Closes any open position for this instrument. Set
// invalidation_close_enabled = false on the config to disable.

// ── INVALIDATION_WARNING_TEMPLATE (optional, logged only) ───────────────────
// {
//   "secret":     "YOUR_SECRET",
//   "alert_type": "invalidation_warning",
//   "tv_symbol":  "{{ticker}}",
//   "tv_price":   {{close}},
//   "timestamp":  "{{timenow}}"
// }

// ── POTENTIAL_BREAKER_TEMPLATE (optional, logged only) ──────────────────────
// {
//   "secret":     "YOUR_SECRET",
//   "alert_type": "potential_breaker",
//   "tv_symbol":  "{{ticker}}",
//   "tv_price":   {{close}},
//   "timestamp":  "{{timenow}}"
// }
